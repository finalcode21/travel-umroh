# ── Database (Neon PostgreSQL) ─────────────────────────────
# Pooled connection string dari Neon (bagian "pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/travel_umroh?sslmode=verify-full"

# ── Clerk (authentication) ─────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Clerk → Webhooks → endpoint: /api/webhooks/clerk (svix signing secret)
CLERK_WEBHOOK_SECRET="whsec_xxx"

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
